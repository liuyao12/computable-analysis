ComputableAnalysis.ExponentialComputations.cellBounds_of_quadratic (f : ComputableAnalysis.FunctionOnInterval)
  (P : Rat → ComputableAnalysis.RealRaw) (h0 : f.lower = 0) (h1 : f.upper = 1)
  (hv : ∀ (x : Rat), 0 ≤ x → x ≤ 1 → (P x).Valid) (C : Rat) (hC : 0 ≤ C) (delta : ComputableAnalysis.QPos) (B : Rat)
  (hB :
    ∀ (x : Rat) (hx : ComputableAnalysis.inDomainInterval f.lower f.upper x) (n : Nat),
      -B ≤ (f.compute x hx n).hi ∧ (f.compute x hx n).lo ≤ B)
  (he :
    ∀ (u v : Rat) (hu : ComputableAnalysis.inDomainInterval f.lower f.upper u),
      0 ≤ u →
        u ≤ v →
          v ≤ 1 →
            v - u ≤ delta.val →
              ComputableAnalysis.FunctionTheory.Small
                (ComputableAnalysis.ComplexRaw.ofRealRaw
                  (((P v).sub (P u)).sub (ComputableAnalysis.RealRaw.scaleRat (v - u) { compute := f.compute u hu })))
                (C * (v - u) ^ 2)) :
  ComputableAnalysis.Integral.CellDerivativeBounds f P
