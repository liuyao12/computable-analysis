ComputableAnalysis.ExponentialComputations.Complex.exp_fiber (z w : ComputableAnalysis.RiemannHilbert.Scalar)
  (h :
    (ComputableAnalysis.ExponentialComputations.Complex.exp z).val.Equiv
      (ComputableAnalysis.ExponentialComputations.Complex.exp w).val) :
  ∃ k, (z.val.sub w.val).Equiv (ComputableAnalysis.ExponentialComputations.Complex.period k).val
ComputableAnalysis.ExponentialComputations.Complex.LogSeed.overlap_period
  (s t : ComputableAnalysis.ExponentialComputations.Complex.LogSeed) (p : ComputableAnalysis.RiemannHilbert.Scalar)
  (hp : s.function.domain p ∧ t.function.domain p) :
  ∃ k,
    ∀ (z : ComputableAnalysis.RiemannHilbert.Scalar) (hz : s.function.domain z ∧ t.function.domain z),
      ((s.function.eval z ⋯).val.sub (t.function.eval z ⋯).val).Equiv
        (ComputableAnalysis.ExponentialComputations.Complex.period k).val
