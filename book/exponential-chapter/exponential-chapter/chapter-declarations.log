ComputableAnalysis.FiniteExponentialTaylor.scheduled_expTaylorPrefix_enclosure {C x : Rat} (hC : 0 ≤ C)
  (hx : ComputableAnalysis.qabs x ≤ C) (eps : ComputableAnalysis.QPos) (extraTerms : Nat) :
  have center :=
    ComputableAnalysis.FinitePolynomial.expTaylorPrefix
      (ComputableAnalysis.FiniteExponentialTaylor.scheduledPrefixDegree C eps) x;
  have later :=
    ComputableAnalysis.FinitePolynomial.expTaylorPrefix
      (ComputableAnalysis.FiniteExponentialTaylor.scheduledPrefixDegree C eps + extraTerms) x;
  center - eps.val ≤ later ∧ later ≤ center + eps.val
