ComputableAnalysis.ExponentialComputations.lipschitzBounds_gap (f : ComputableAnalysis.FunctionOnInterval)
  (h0 : f.lower = 0) (h1 : f.upper = 1) (L : Rat) (hL : 0 ≤ L)
  (hlip :
    ∀ (x y : Rat) (hx : ComputableAnalysis.inDomainInterval f.lower f.upper x)
      (hy : ComputableAnalysis.inDomainInterval f.lower f.upper y),
      ComputableAnalysis.FunctionTheory.Small
        (ComputableAnalysis.ComplexRaw.ofRealRaw
          ((ComputableAnalysis.ExponentialComputations.pointRaw✝ f x hx).sub
            (ComputableAnalysis.ExponentialComputations.pointRaw✝ f y hy)))
        (L * ComputableAnalysis.qabs (x - y)))
  (eps : ComputableAnalysis.QPos) :
  (ComputableAnalysis.ExponentialComputations.lipschitzBounds f h0 h1 L hL hlip eps).upperSum -
      (ComputableAnalysis.ExponentialComputations.lipschitzBounds f h0 h1 L hL hlip eps).lowerSum ≤
    eps.val
