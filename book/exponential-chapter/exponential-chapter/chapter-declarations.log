ComputableAnalysis.ExponentialComputations.log_increment_error
  (c z : ComputableAnalysis.ExponentialComputations.PositiveInput) (B H : Rat) (hB : 0 ≤ B) (hH : 0 ≤ H)
  (hi :
    ComputableAnalysis.FunctionTheory.Small
      (ComputableAnalysis.RiemannHilbert.RepresentedReciprocal.inverse
          (ComputableAnalysis.ExponentialComputations.realAxis c.val) ⋯).val
      B)
  (hstep :
    ComputableAnalysis.FunctionTheory.Small
      ((ComputableAnalysis.ExponentialComputations.realAxis z.val).val.sub
        (ComputableAnalysis.ExponentialComputations.realAxis c.val).val)
      H)
  (hmesh : 2 * B * H ≤ 1 / 128) :
  ComputableAnalysis.FunctionTheory.Small
    (ComputableAnalysis.ComplexRaw.ofRealRaw
      (((ComputableAnalysis.ExponentialComputations.log z).val.sub
            (ComputableAnalysis.ExponentialComputations.log c).val).sub
        ((ComputableAnalysis.RiemannHilbert.RepresentedReciprocal.inverse
                  (ComputableAnalysis.ExponentialComputations.realAxis c.val) ⋯).val.mul
            ((ComputableAnalysis.ExponentialComputations.realAxis z.val).val.sub
              (ComputableAnalysis.ExponentialComputations.realAxis c.val).val)).realPart))
    (16 * (2 * B * H) ^ 2)
